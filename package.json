    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
