{
  "name": "postgres-mcp",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "postgres-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/tests/integration.test.js",
